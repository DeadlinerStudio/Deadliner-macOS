    "完成情况统计到今天（%@）；之后的日期只计入到期的任务。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completion is counted up to today (%@); later dates only count tasks that are due."
          }
        }
      }
    },
    "完成按完成日期，其余按截止日期": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed by completion date, others by deadline"
          }
        }
      }
    },
    "完成时显示动画效果": {
      "localizations": {
