  "strings": {
    "NSCalendarsFullAccessUsageDescription": {
      "comment": "Calendar permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to add tasks to your calendar and to import tasks from calendar events. Accessed only when you click the related buttons."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于把任务添加到日历，以及从日历事件导入任务。只在你点按相关按钮时访问。"
          }
        }
      }
    },
